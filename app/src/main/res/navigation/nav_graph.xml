<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.focusboard.ui.splash.SplashFragment"
        android:label="Splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_workspaceList"
            app:destination="@id/workspaceListFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.focusboard.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_workspaceList"
            app:destination="@id/workspaceListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.focusboard.ui.auth.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_register_to_workspaceList"
            app:destination="@id/workspaceListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/workspaceListFragment"
        android:name="com.example.focusboard.ui.workspace.WorkspaceListFragment"
        android:label="Workspaces">
        <action
            android:id="@+id/action_workspaceList_to_pageList"
            app:destination="@id/pageListFragment" />
    </fragment>

    <fragment
        android:id="@+id/pageListFragment"
        android:name="com.example.focusboard.ui.page.PageListFragment"
        android:label="Pages">
        <argument
            android:name="workspaceId"
            app:argType="string" />
        <action
            android:id="@+id/action_pageList_to_pageDetail"
            app:destination="@id/pageDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/pageDetailFragment"
        android:name="com.example.focusboard.ui.page.PageDetailFragment"
        android:label="Page">
        <argument
            android:name="pageId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/taskListFragment"
        android:name="com.example.focusboard.ui.tasks.TaskListFragment"
        android:label="Tasks" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.focusboard.ui.profile.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
